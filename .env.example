# Microsoft Entra / Graph credentials
CLIENT_ID=your-client-id
TENANT_ID=your-tenant-id
CLIENT_SECRET=your-client-secret
GROUP_ID=your-group-id

# Teams SSO API validation
# AUTH_AUDIENCE should match teams/manifest.json webApplicationInfo.id
AUTH_AUDIENCE=your-app-registration-client-id
# Comma-separated tenant IDs, or * for multi-tenant access
AUTH_ALLOWED_TENANTS=your-tenant-id

# Browser admin/dev access
# Optional shared key sent via x-dev-access-key header or ?devKey=... query param
DEV_ACCESS_KEY=
# Optional localhost bypass for development only
ALLOW_LOCALHOST_BROWSER=false
# Optional verbose auth diagnostics in server logs
AUTH_DEBUG=false

# Feedback feature
# Enables /api/feedback submit endpoint and Feedback UI button
FEEDBACK_ENABLED=false
# Required for dev-only feedback management endpoints (/api/feedback GET/DELETE + CSV)
FEEDBACK_DEV_KEY=
# Feedback export unlock session duration in minutes (minimum 15)
FEEDBACK_EXPORT_SESSION_TTL_MIN=240

# Admin panel / dashboard scope controls
# 6-digit PIN required to unlock admin panel in UI
ADMIN_PIN=
# Admin session duration in minutes (minimum 15)
ADMIN_SESSION_TTL_MIN=240
# HMAC secret for HttpOnly admin session cookie signing
# If empty, backend falls back to CLIENT_SECRET
ADMIN_SESSION_SECRET=

# Web server
PORT=3000

# Optional snapshot schedule in UTC (HH:mm)
# If set, snapshots run at this daily UTC time.
# If empty, scheduler runs 24h after the latest successful snapshot.
SNAPSHOT_TIME_UTC=
